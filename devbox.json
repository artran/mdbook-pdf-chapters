{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "mdbook@latest",
    "mdbook-pdf-outline@latest",
    "rustup@latest",
    "libiconv@latest"
  ],
  "shell": {
    "init_hook": [
      "export RUSTUP_HOME=$DEVBOX_PROJECT_ROOT/.rustup",
      "mkdir -p $RUSTUP_HOME",
      "export LIBRARY_PATH=$LIBRARY_PATH:\"$DEVBOX_PROJECT_ROOT/nix/profile/default/lib\"",
      "rustup default stable",
      "cargo fetch"
    ],
    "scripts": {
      "test": [
        "cargo test"
      ]
    }
  }
}
